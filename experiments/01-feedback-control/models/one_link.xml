<mujoco model="one_link_feedback_control">
  <compiler angle="radian" autolimits="true"/>

  <!--
    A deliberately small plant for isolating controller behavior.
    Generalized position is the hinge angle in radians. Positive rotation moves
    the arm toward +x. Gravity is disabled so the first comparison isolates
    feedback damping rather than gravity compensation.
  -->
  <option
    timestep="0.002"
    gravity="0 0 0"
    integrator="RK4"
    solver="Newton"
  />

  <statistic center="0 0 0.35" extent="1.15"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2"/>
    <rgba haze="0.08 0.10 0.14 1"/>
  </visual>

  <asset>
    <texture
      name="floor_grid"
      type="2d"
      builtin="checker"
      rgb1="0.10 0.12 0.16"
      rgb2="0.16 0.19 0.24"
      width="512"
      height="512"
    />
    <material
      name="floor_material"
      texture="floor_grid"
      texrepeat="4 4"
      reflectance="0.15"
    />
    <material name="base_material" rgba="0.20 0.23 0.30 1"/>
    <material name="arm_material" rgba="0.10 0.48 0.95 1"/>
    <material name="joint_material" rgba="0.82 0.88 0.96 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="-1.5 -2.0 3.0" dir="0.4 0.5 -1"/>
    <camera
      name="demo_camera"
      pos="0 -3 0.55"
      xyaxes="1 0 0 0 0 1"
      fovy="38"
    />

    <geom
      name="floor"
      type="plane"
      pos="0 0 -0.18"
      size="2 2 0.1"
      material="floor_material"
      contype="0"
      conaffinity="0"
    />

    <!-- The red guide and sphere mark the fixed +60 degree target. -->
    <geom
      name="target_guide"
      type="capsule"
      fromto="0 0 0 0.692820 0 0.400000"
      size="0.012"
      rgba="1.0 0.20 0.16 0.30"
      contype="0"
      conaffinity="0"
    />
    <site
      name="target"
      type="sphere"
      pos="0.692820 0 0.400000"
      size="0.065"
      rgba="1.0 0.20 0.16 0.90"
    />

    <body name="base" pos="0 0 -0.09">
      <geom
        name="base_geom"
        type="cylinder"
        size="0.16 0.09"
        material="base_material"
        contype="0"
        conaffinity="0"
      />

      <body name="arm" pos="0 0 0.09">
        <joint
          name="hinge"
          type="hinge"
          axis="0 1 0"
          range="-1.570796 1.570796"
          damping="0.05"
          frictionloss="0"
          armature="0.01"
        />
        <geom
          name="arm_link"
          type="capsule"
          fromto="0 0 0 0 0 0.8"
          size="0.045"
          mass="1.0"
          material="arm_material"
        />
        <geom
          name="joint_hub"
          type="cylinder"
          quat="0.707107 0.707107 0 0"
          size="0.085 0.075"
          mass="0.05"
          material="joint_material"
          contype="0"
          conaffinity="0"
        />
        <site
          name="end_effector"
          type="sphere"
          pos="0 0 0.8"
          size="0.06"
          rgba="0.95 0.98 1 1"
        />
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor
      name="torque_motor"
      joint="hinge"
      gear="1"
      ctrllimited="true"
      ctrlrange="-3 3"
    />
  </actuator>

  <keyframe>
    <key name="start" qpos="-1.047198" qvel="0" ctrl="0"/>
  </keyframe>
</mujoco>
